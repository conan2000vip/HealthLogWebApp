# .env.example
# このファイルを ".env" にコピーして、実際の値を入力してください。
# コマンド: cp .env.example .env
# 実際の ".env" ファイルは Git にコミットしないでください。

# ---- Spring Boot アプリケーション設定 ----
DB_USERNAME=
DB_PASSWORD=

# ---- MySQL コンテナ設定（docker-compose用） ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=healthlog
MYSQL_USER=
MYSQL_PASSWORD=

# ---- ポート設定 ----
# 使用中のサービスとポートが競合する場合は変更してください。
DB_PORT=3307
APP_PORT=8080